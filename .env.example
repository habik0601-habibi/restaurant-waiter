# Supabase project (Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Branch the app opens by default (printed by the seed script)
VITE_DEFAULT_BRANCH_ID=00000000-0000-0000-0000-0000000000b1

# Only used by `npm run test:db` (integration tests against the real database).
# Demo staff logins created by supabase/seed/02_staff_users.sql.
TEST_OWNER_EMAIL=owner@zaiqa.test
TEST_OWNER_PASSWORD=
TEST_WAITER_EMAIL=waiter@zaiqa.test
TEST_WAITER_PASSWORD=
TEST_KITCHEN_EMAIL=kitchen@zaiqa.test
TEST_KITCHEN_PASSWORD=
